<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">transfernetwork_relation_form.relation_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Relation Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Tirehub\TransferNetwork\Block\Adminhtml\Relation\Edit\BackButton"/>
            <button name="delete" class="Tirehub\TransferNetwork\Block\Adminhtml\Relation\Edit\DeleteButton"/>
            <button name="save" class="Tirehub\TransferNetwork\Block\Adminhtml\Relation\Edit\SaveButton"/>
            <button name="save_and_continue" class="Tirehub\TransferNetwork\Block\Adminhtml\Relation\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>transfernetwork_relation_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>transfernetwork_relation_form.relation_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="relation_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="transfernetwork/relation/save"/>
        </settings>
        <dataProvider class="Tirehub\TransferNetwork\Model\LocationRelation\DataProvider" name="relation_form_data_source">
            <settings>
                <requestFieldName>relation_id</requestFieldName>
                <primaryFieldName>relation_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General Information</label>
        </settings>
        <field name="relation_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>relation_id</dataScope>
            </settings>
        </field>
        <field name="location_id_from" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">From Location</label>
                <dataScope>location_id_from</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Tirehub\TransferNetwork\Model\Config\Source\LocationOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="location_id_to" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">To Location</label>
                <dataScope>location_id_to</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Tirehub\TransferNetwork\Model\Config\Source\LocationOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="color_id" formElement="select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Color</label>
                <dataScope>color_id</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Tirehub\TransferNetwork\Model\Config\Source\ColorOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="active" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Active</label>
                <dataScope>active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="cutoff_days" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-digits-range" xsi:type="boolean">true</rule>
                    <rule name="digits-range-min" xsi:type="number">0</rule>
                    <rule name="digits-range-max" xsi:type="number">99.9</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Cutoff Days</label>
                <dataScope>cutoff_days</dataScope>
                <notice translate="true">Supports 1 decimal place (e.g., 1.5 days)</notice>
            </settings>
        </field>
        <field name="cutoff_time" formElement="date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Cutoff Time</label>
                <dataScope>cutoff_time</dataScope>
                <additionalClasses>
                    <class name="admin__field-date">true</class>
                </additionalClasses>
            </settings>
            <formElements>
                <date>
                    <settings>
                        <options>
                            <option name="showsTime" xsi:type="boolean">true</option>
                            <option name="timeOnly" xsi:type="boolean">true</option>
                            <option name="timeFormat" xsi:type="string">HH:mm</option>
                            <option name="dateFormat" xsi:type="string"></option>
                        </options>
                    </settings>
                </date>
            </formElements>
        </field>
        <field name="unload_minutes" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">relation</item>
                </item>
            </argument>
            <settings>
                <dataType>number</dataType>
                <label translate="true">Unload Minutes</label>
                <dataScope>unload_minutes</dataScope>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                    <rule name="validate-zero-or-greater" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
</form>
