<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">transfernetwork_relation_listing.transfernetwork_relation_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>transfernetwork_relation_columns</spinner>
        <deps>
            <dep>transfernetwork_relation_listing.transfernetwork_relation_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Relation</label>
            </button>
            <button name="import">
                <class>action-secondary</class>
                <label translate="true">Import from Excel</label>
                <actions>
                    <action name="0">
                        <targetName>transfernetwork_relation_listing.transfernetwork_relation_listing.relation_import_modal</targetName>
                        <actionName>openModal</actionName>
                    </action>
                </actions>
            </button>
            <button name="export">
                <url path="*/*/export"/>
                <class>action-secondary</class>
                <label translate="true">Export to Excel</label>
            </button>
        </buttons>
    </settings>
    <dataSource name="transfernetwork_relation_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">relation_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Tirehub_TransferNetwork::relation</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="transfernetwork_relation_listing_data_source">
            <settings>
                <requestFieldName>relation_id</requestFieldName>
                <primaryFieldName>relation_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete selected items?</message>
                        <title translate="true">Delete items</title>
                    </confirm>
                    <url path="transfernetwork/relation/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="transfernetwork_relation_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="transfernetwork/relation/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">relation_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">transfernetwork_relation_listing.transfernetwork_relation_listing.transfernetwork_relation_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">transfernetwork_relation_listing.transfernetwork_relation_listing.transfernetwork_relation_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>relation_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="relation_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Relation ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="location_id_from">
            <settings>
                <filter>textRange</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">From Location ID</label>
            </settings>
        </column>
        <column name="location_id_to">
            <settings>
                <filter>textRange</filter>
                <editor>
                    <validation>
                        <rule name="required-entry" xsi:type="boolean">true</rule>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">To Location ID</label>
            </settings>
        </column>
        <column name="relation_color_display" class="Tirehub\TransferNetwork\Ui\Component\Listing\Column\RelationColor">
            <settings>
                <label translate="true">Color</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="color_id" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="Tirehub\TransferNetwork\Model\Config\Source\ColorOptions"/>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Color ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="active" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Active</label>
            </settings>
        </column>
        <column name="cutoff_days">
            <settings>
                <filter>textRange</filter>
                <editor>
                    <validation>
                        <rule name="validate-number" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Cutoff Days</label>
            </settings>
        </column>
        <column name="cutoff_time" class="Tirehub\TransferNetwork\Ui\Component\Listing\Column\CutoffTime">
            <settings>
                <filter>text</filter>
                <label translate="true">Cutoff Time</label>
            </settings>
        </column>
        <column name="unload_minutes">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Unload Minutes</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created At</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Tirehub\TransferNetwork\Ui\Component\Listing\Column\RelationActions">
            <settings>
                <indexField>relation_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
    <modal name="relation_import_modal" component="Magento_Ui/js/modal/modal-component">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Import Relations from Excel</option>
                <option name="type" xsi:type="string">popup</option>
                <option name="responsive" xsi:type="boolean">true</option>
                <option name="innerScroll" xsi:type="boolean">true</option>
                <option name="modalClass" xsi:type="string">import-relations-modal</option>
                <option name="buttons" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Cancel</item>
                        <item name="class" xsi:type="string">action-secondary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="string">closeModal</item>
                        </item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="text" xsi:type="string" translate="true">Import</item>
                        <item name="class" xsi:type="string">action-primary</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">transfernetwork_relation_listing.transfernetwork_relation_listing.relation_import_modal.relation_import_form</item>
                                <item name="actionName" xsi:type="string">save</item>
                            </item>
                        </item>
                    </item>
                </option>
            </options>
        </settings>
        <form name="relation_import_form">
            <argument name="data" xsi:type="array">
                <item name="js_config" xsi:type="array">
                    <item name="component" xsi:type="string">Tirehub_TransferNetwork/js/form/import-form</item>
                </item>
            </argument>
            <settings>
                <deps>
                    <dep>transfernetwork_relation_listing.transfernetwork_relation_listing_data_source</dep>
                </deps>
                <namespace>transfernetwork_relation_listing</namespace>
                <ajaxSave>true</ajaxSave>
                <ajaxSaveType>simple</ajaxSaveType>
                <dataScope>data</dataScope>
            </settings>
            <dataSource name="relation_import_data_source">
                <argument name="data" xsi:type="array">
                    <item name="js_config" xsi:type="array">
                        <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
                    </item>
                </argument>
                <settings>
                    <submitUrl path="transfernetwork/relation/import"/>
                </settings>
            </dataSource>
            <fieldset name="import_fieldset">
                <settings>
                    <label translate="true">Import Configuration</label>
                    <collapsible>false</collapsible>
                    <opened>true</opened>
                </settings>
                <field name="import_file" formElement="fileUploader">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="source" xsi:type="string">import</item>
                        </item>
                    </argument>
                    <settings>
                        <elementTmpl>ui/form/element/uploader/uploader</elementTmpl>
                        <dataType>string</dataType>
                        <label translate="true">Select Excel/CSV File</label>
                        <dataScope>import_file</dataScope>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <fileUploader>
                            <settings>
                                <allowedExtensions>csv xlsx xls</allowedExtensions>
                                <maxFileSize>10485760</maxFileSize>
                                <uploaderConfig>
                                    <param xsi:type="url" name="url" path="transfernetwork/relation/uploadFile"/>
                                </uploaderConfig>
                                <previewTmpl>Magento_Catalog/image-preview</previewTmpl>
                            </settings>
                        </fileUploader>
                    </formElements>
                </field>
                <container name="import_instructions">
                    <argument name="data" xsi:type="array">
                        <item name="config" xsi:type="array">
                            <item name="template" xsi:type="string">ui/form/components/complex</item>
                        </item>
                    </argument>
                    <htmlContent name="instructions_content">
                        <argument name="block" xsi:type="object">Tirehub\TransferNetwork\Block\Adminhtml\Relation\ImportInstructions</argument>
                    </htmlContent>
                </container>
            </fieldset>
        </form>
    </modal>
</listing>