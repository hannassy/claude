<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title">
            <arguments>
                <argument name="css_class" xsi:type="string">routes-map-title-wrapper</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Tirehub\TransferNetwork\Block\Map"
                    name="routes-map-container"
                    template="Tirehub_TransferNetwork::map/container.phtml"/>
        </referenceContainer>
    </body>
</page>
