<?xml version="1.0"?>
<!--
Path: app/code/Tirehub/TransferNetwork/view/frontend/layout/transfernetwork_index_index.xml
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Transfer Network Map</title>
        <css src="Tirehub_TransferNetwork::css/transfernetwork.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                    name="transfernetwork.map"
                    template="Tirehub_TransferNetwork::map.phtml">
                <arguments>
                    <argument name="ajax_url" xsi:type="url" path="transfernetwork/ajax/locations"/>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>