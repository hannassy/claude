<div class="transfer-network-container">
    <div class="page-title-wrapper">
        <h1 class="page-title">
            <span class="base" data-ui-id="page-title-wrapper"><?= __('Transfer Network Map') ?></span>
        </h1>
    </div>

    <div class="transfer-network-content">
        <div id="loading-message" class="loading-message">
            <?= __('Loading map...') ?>
        </div>

        <div id="map-container" class="map-container" style="display: none;">
            <div id="google-map" style="height: 600px; width: 100%;"></div>
        </div>

        <div id="error-message" class="error-message" style="display: none;">
            <?= __('Unable to load map. Please try again later.') ?>
        </div>
    </div>
</div>

<script>
    require([
        'jquery',
        'Tirehub_TransferNetwork/js/map'
    ], function ($, TransferNetworkMap) {
        'use strict';

        $(document).ready(function() {
            const mapConfig = {
                ajaxUrl: '<?= $block->getArgument('ajax_url') ?>',
                center: {
                    lat: 48.4647, // Dnipro coordinates
                    lng: 35.0462
                },
                zoom: 8
            };

            const transferNetworkMap = new TransferNetworkMap(mapConfig);
            transferNetworkMap.init();
        });
    });
</script>

<!-- Google Maps API - Replace YOUR_API_KEY with your actual Google Maps API key -->
<script async defer
        src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap">
</script>

<script>
    function initMap() {
        // This function will be called by the Google Maps API
        // The actual map initialization is handled by our custom JS module
        if (window.transferNetworkMapReady) {
            window.transferNetworkMapReady();
        }
    }
</script>
