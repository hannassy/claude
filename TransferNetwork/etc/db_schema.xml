<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="tirehub_transfernetwork_location" resource="default" engine="innodb" comment="Transfer Network Locations">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="location_id" padding="10" unsigned="true" nullable="false" comment="Location ID"/>
        <column xsi:type="varchar" name="location_name" nullable="false" length="255" comment="Location Name"/>
        <column xsi:type="decimal" name="latitude" scale="8" precision="11" nullable="false" comment="Latitude"/>
        <column xsi:type="decimal" name="longitude" scale="8" precision="11" nullable="false" comment="Longitude"/>
        <column xsi:type="varchar" name="rdc_cluster" nullable="true" length="100" comment="RDC Cluster"/>
        <column xsi:type="varchar" name="pin_color" nullable="true" length="50" comment="Pin Color"/>
        <column xsi:type="boolean" name="active" nullable="false" default="1" comment="Active Status"/>
        <column xsi:type="boolean" name="rdc_inventory_visible" nullable="false" default="0" comment="RDC Inventory Visible"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="TIREHUB_TRANSFERNETWORK_LOCATION_ID_UNIQUE">
            <column name="location_id"/>
        </constraint>
        <index referenceId="TIREHUB_TRANSFERNETWORK_LOCATION_NAME" indexType="btree">
            <column name="location_name"/>
        </index>
        <index referenceId="TIREHUB_TRANSFERNETWORK_LOCATION_ACTIVE" indexType="btree">
            <column name="active"/>
        </index>
        <index referenceId="TIREHUB_TRANSFERNETWORK_LOCATION_RDC_CLUSTER" indexType="btree">
            <column name="rdc_cluster"/>
        </index>
    </table>

    <table name="tirehub_transfernetwork_location_relation" resource="default" engine="innodb" comment="Transfer Network Location Relations">
        <column xsi:type="int" name="relation_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Relation ID"/>
        <column xsi:type="int" name="location_id_from" padding="10" unsigned="true" nullable="false" comment="From Location ID"/>
        <column xsi:type="int" name="location_id_to" padding="10" unsigned="true" nullable="false" comment="To Location ID"/>
        <column xsi:type="boolean" name="active" nullable="false" default="1" comment="Active Status"/>
        <column xsi:type="int" name="cutoff_days" padding="10" unsigned="true" nullable="true" comment="Cutoff Days"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="relation_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="TIREHUB_TRANSFERNETWORK_RELATION_FROM_LOCATION_ID"
                table="tirehub_transfernetwork_location_relation" column="location_id_from"
                referenceTable="tirehub_transfernetwork_location" referenceColumn="location_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="TIREHUB_TRANSFERNETWORK_RELATION_TO_LOCATION_ID"
                table="tirehub_transfernetwork_location_relation" column="location_id_to"
                referenceTable="tirehub_transfernetwork_location" referenceColumn="location_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="TIREHUB_TRANSFERNETWORK_LOCATION_RELATION_UNIQUE">
            <column name="location_id_from"/>
            <column name="location_id_to"/>
        </constraint>
        <index referenceId="TIREHUB_TRANSFERNETWORK_RELATION_ACTIVE" indexType="btree">
            <column name="active"/>
        </index>
        <index referenceId="TIREHUB_TRANSFERNETWORK_RELATION_CUTOFF_DAYS" indexType="btree">
            <column name="cutoff_days"/>
        </index>
    </table>

</schema>